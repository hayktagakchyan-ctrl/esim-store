# Скопировать в .env и заполнить реальными значениями. .env никогда не коммитить в git.

CLIENT_BOT_TOKEN=123456:AAA-client-bot-token
SUPPORT_BOT_TOKEN=123456:AAA-support-bot-token
SUPPORT_CHAT_ID=123456789

DATABASE_URL=sqlite+aiosqlite:///./esim_bot.db
# для продакшена:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/esim_bot

ESIMACCESS_ACCESS_CODE=
ESIMACCESS_WEBHOOK_ENFORCE_IP_ALLOWLIST=false

ADMIN_PANEL_SECRET_KEY=change-me-to-a-random-string
ADMIN_PANEL_LOGIN=admin
ADMIN_PANEL_PASSWORD=change-me

# Сессия для логина на сайте (отдельно от админки) — впиши любую случайную строку
SHOP_SESSION_SECRET_KEY=change-me-too

# SMTP для писем восстановления пароля на сайте. Если оставить пустым — письма
# не отправляются, но ссылка на сброс пароля продублируется в бот поддержки,
# так что тестировать можно и без настроенного SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=eSIM Store
SMTP_USE_TLS=true

# Idram (EDP-протокол) — IdramID и секретный ключ выдаёт Idram после подписания договора
IDRAM_REC_ACCOUNT=
IDRAM_SECRET_KEY=
# Подтверждено официальным документом Idram — можно оставить как есть
IDRAM_PAYMENT_URL=https://banking.idram.am/Payment/GetPayment

# Wallet Pay (Telegram-кошелёк: крипта + сам Telegram Wallet) — токен с https://pay.wallet.tg/
WALLET_PAY_API_KEY=

# OxaPay (крипта с любого адреса/биржи, напр. вывод прямо с Bybit — без Telegram Wallet)
# Ключ — в личном кабинете oxapay.com, раздел Merchant
OXAPAY_MERCHANT_API_KEY=

# Публичный адрес процесса app/webapp (тот же, что и MINIAPP_URL, без /miniapp) —
# нужен Idram для RESULT_URL/SUCCESS_URL/FAIL_URL
PUBLIC_BASE_URL=https://example.com

# HTTPS-адрес, где будет размещён Mini App (обязателен для кнопки web_app в боте).
# Для локальной разработки — временный туннель, напр. ngrok: https://xxxx.ngrok-free.app
MINIAPP_URL=https://example.com/miniapp

# Кнопка "🧪 Тестовая оплата" в чекауте — для теста реальной цепочки без платёжки.
# ОБЯЗАТЕЛЬНО поставить false перед реальным запуском для клиентов.
ENABLE_TEST_PAYMENT=true

# На Railway (или любом хостинге за HTTPS) поставь true — cookie сессий (админка,
# сайт) будут отправляться только по HTTPS. Локально (http://localhost) — false.
SECURE_COOKIES=false

# Временно скрыть отдельные способы оплаты (пока не готов ключ/аккаунт) — не
# трогает код, просто прячет кнопку и блокирует сам эндпоинт на сервере.
# Например, пока готов только Idram: обе строки ниже поставь false.
ENABLE_WALLET_PAY=true
ENABLE_OXAPAY=true
